{
  "name": "stellar-wallet-kit",
  "version": "2.0.0",
  "description": "A comprehensive wallet connection kit for Stellar dApps",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "prepublishOnly": "npm run build",
    "lint": "eslint src --ext .ts,.tsx",
    "type-check": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@stellar/freighter-api": "^2.0.0",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "eslint": "^8.0.0"
  },
  "keywords": [
    "stellar",
    "wallet",
    "freighter",
    "blockchain",
    "web3",
    "soroban",
    "react"
  ],
  "author": "Tushar Pamnani <tusharpamnani1@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tusharpamnani/stellar-wallet-kit"
  },
  "homepage": "https://github.com/yourusername/stellar-wallet-kit#readme",
  "bugs": {
    "url": "https://github.com/yourusername/stellar-wallet-kit/issues"
  }
}