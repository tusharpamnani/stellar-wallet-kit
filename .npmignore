# .npmignore

# Source files (only include built dist/)
src/
example/
docs/

# Tests
*.test.ts
*.test.tsx
*.spec.ts
*.spec.tsx
__tests__/
coverage/

# Config files
tsconfig.json
tsup.config.ts
.eslintrc*
.prettierrc*
.editorconfig
jest.config.*

# Development
.github/
.vscode/
.idea/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment
.env
.env.local
.env.*.local

# OS files
.DS_Store
Thumbs.db

# Build artifacts
*.tsbuildinfo
.turbo/

# Don't ignore dist
!dist/